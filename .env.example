# ===================================================================
# AI Website Builder Agent - Environment Configuration
# ===================================================================

# Application Configuration
APP_NAME="AI Website Builder Agent"
APP_ENV="development"
DEBUG=true
PORT=8008
HOST="127.0.0.1"
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-key-in-production"

# Database Configuration (SQLite via aiosqlite asynchronous driver)
DATABASE_URL="sqlite+aiosqlite:///./storage/website_builder.db"

# Storage Configuration
PROJECTS_STORAGE_DIR="./storage/projects"

# Google Gemini AI Provider
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Unsplash API (Optional for asset agent photo queries; fallbacks provided automatically)
UNSPLASH_ACCESS_KEY=""

# Email Provider Configuration (Optional for contact form forwarding)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
NOTIFICATION_EMAIL=""

# Deployment Provider Tokens (Optional: configure here or directly in the UI Settings)
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""
NETLIFY_AUTH_TOKEN=""
NETLIFY_SITE_ID=""

# Security and Execution Policies
REQUIRE_COMMAND_APPROVAL=true
ALLOWLISTED_COMMANDS="npm run build,npm test,npm run lint,git status,git log,git diff,git commit"
COMMAND_TIMEOUT_SECONDS=60
